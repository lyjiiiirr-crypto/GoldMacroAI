# 复制为 .env 并填写；.env 绝不提交到 GitHub
FRED_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 本地 AI（Windows + Ollama）
OLLAMA_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60

# 可选：兼容 OpenAI /chat/completions 格式的云端备用模型
CLOUD_AI_BASE_URL=
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=qwen/qwen3-8b:free

# 免注册推送备选（不填则用 Telegram；都没填则不推送）
# 可运行 python main.py --setup-ntfy 自动生成随机 topic
NTFY_TOPIC=

# 同一类提醒的冷却时间（小时）
ALERT_COOLDOWN_HOURS=12

# 可选：免费数据源入口（一般无需修改；换镜像/自建代理时可覆盖）
# BLS_API_URL=https://api.bls.gov/publicAPI/v1/timeseries/data/
# CFTC_HISTORY_URL=https://www.cftc.gov/files/dea/history/
# FOMC_CALENDAR_URL=https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm
# WGC_API_BASE=https://fsapi.gold.org/api/v11/charts/etfv2/revised
# FEDWATCH_ARCHIVE_URL=https://raw.githubusercontent.com/zuowood1234/cme-fedwatch-tracker/main/data/daily/{date}.json
# Polymarket 利率预测：公开 Gamma API，无密钥；失败时优雅降级，可 --import-polymarket 人工导入
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# YHOO_DXY_URL=https://query1.finance.yahoo.com/v8/finance/chart/DX-Y.NYB?range=1mo&interval=1d
# 技术面报告（公开行情 + 本地自算，非 Trading Central 官方研报）
# 黄金日线优先用 XAUS 免费公开实时行情（免密钥、带 data_state 校验），失败回退 Yahoo
# TECHNICAL_SYMBOLS=GC=F
# XAUS_HISTORY_URL=https://xaus.com/api/v1/history?days={days}
# YHOO_TECH_URL=https://query1.finance.yahoo.com/v8/finance/chart/{symbol}?range=1y&interval=1d
# 1H CRT 六根结构：XAUS 60m 原生已收盘 K 线提供 P1~P6，TradingView scanner 的 [1] 已收盘列覆盖 P6
# 只用已收盘 K 线（不拿实时现货覆盖收盘）；P6 缺失时回退 Yahoo 1H，最后回退本地历史快照
# 收线为每小时 UTC 整点（北京整点）；云端在每小时 hh:01 采集检查；仅 CRT 成立时推送
# 逐根判定：P6 扫过 P1~P5 中任意一根的高/低点，且收盘回到该根 [低,高] 内（收回影线内）则 CRT 成立
# 多根满足时取最靠近 P6 的那根（P5 优先）为主信号；结构位仅供参考，未回测，非交易信号
# CRT_SYMBOLS=XAUUSD
# XAUS_CHART_URL=https://xaus.com/api/v1/chart?symbol={symbol}&range={range}&interval={interval}
# XAUS_SPOT_URL=https://xaus.com/api/v1/spot?compact=1
# TV_CRT_SYMBOL=OANDA:XAUUSD
# TV_CRT_URL=https://scanner.tradingview.com/global/scan
# YHOO_CRT_URL=https://query1.finance.yahoo.com/v8/finance/chart/{symbol}?range=1mo&interval={interval}
# GEX / Gamma flip：Cboe 免费延迟期权报价（GLD 黄金代理 + SPY 大盘），延迟近似，非交易信号
# GEX_SYMBOLS=GLD,SPY
# GEX_MAX_DAYS=90
# GEX_GRID_STEPS=161
# CBOE_OPTIONS_URL=https://cdn.cboe.com/api/global/delayed_quotes/options/{symbol}.json
# FRANKFURTER_URL=https://api.frankfurter.dev/v1/{start}..?base=USD&symbols=EUR,JPY,GBP,CAD,SEK,CHF
